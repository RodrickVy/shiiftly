# ---------------------------------------------------------------------------
# Shiftly environment
#
# Copy to .env and fill in. The app refuses to start pretending to work:
# with anything missing it serves /setup-required and says what is absent.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-side only. Bypasses Row Level Security -- never expose to the browser
# and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Signs the daily station QR tokens. At least 32 characters.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Rotating this invalidates every outstanding station code, which is intended.
QR_TOKEN_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Email (optional). Without RESEND_API_KEY the app uses a development adapter
# that logs messages to the console and records the delivery as failed -- it
# does not claim to have sent mail it did not send.
RESEND_API_KEY=""
EMAIL_FROM="Shiftly <onboarding@resend.dev>"

# Confirm new accounts server-side instead of emailing a confirmation link.
# Useful while no email provider is configured, since otherwise the link goes
# nowhere and no signup can complete. This means the address is NOT verified:
# switch it off before relying on email as identity or for password reset.
AUTH_AUTOCONFIRM="false"

# Public base URL, used in invitation links when the request origin is not
# what you want (behind a proxy, for example). Optional.
PUBLIC_APP_URL=""
